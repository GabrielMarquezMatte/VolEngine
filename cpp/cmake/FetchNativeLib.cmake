# Defines the IMPORTED target volengine::native: the VolEngine shared library for the host platform, downloaded from
# the GitHub Release of VOLENGINE_VERSION (the assets of .github/workflows/release.yml), or the file named by the
# environment variable VOLENGINE_NATIVE_LIB (a local build; nothing is downloaded).
#
# With VOLENGINE_NATIVE_LIB on Windows, the files volengine.def and libvolengine.dll.a must sit next to the DLL: the
# build tree of a MinGW build and python/src/volengine/_lib both have them. MSVC links through an import library made
# from the .def; MinGW links through the .dll.a.

# volengine_asset_name(<os> <arch> <out>): the release asset of a platform. os is win, osx, linux or linux-musl; arch is
# x64 or arm64.
function(volengine_asset_name os arch out)
    if(os STREQUAL "win")
        set(_ext "dll")
    elseif(os STREQUAL "osx")
        set(_ext "dylib")
    else()
        set(_ext "so")
    endif()
    set(${out} "volengine-native-${os}-${arch}.${_ext}" PARENT_SCOPE)
endfunction()

# volengine_cache_directory(<build dir> <tag> <out>): where the library of a release is downloaded. One directory per tag,
# so a build directory that moves to the next release downloads it instead of reusing the files of the old one.
function(volengine_cache_directory build_directory tag out)
    set(${out} "${build_directory}/volengine-native/${tag}" PARENT_SCOPE)
endfunction()

function(volengine_host_platform os_out arch_out)
    if(WIN32)
        set(_os "win")
    elseif(APPLE)
        set(_os "osx")
    else()
        file(GLOB _musl_loader "/lib/ld-musl-*.so.1")
        if(_musl_loader)
            set(_os "linux-musl")
        else()
            set(_os "linux")
        endif()
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64|ARM64)$")
        set(_arch "arm64")
    else()
        set(_arch "x64")
    endif()
    set(${os_out} "${_os}" PARENT_SCOPE)
    set(${arch_out} "${_arch}" PARENT_SCOPE)
endfunction()

function(volengine_download url destination)
    if(EXISTS "${destination}")
        return()
    endif()
    message(STATUS "Downloading VolEngine: ${url}")
    file(DOWNLOAD "${url}" "${destination}" STATUS _status)
    list(GET _status 0 _code)
    if(NOT _code EQUAL 0)
        file(REMOVE "${destination}")
        list(GET _status 1 _message)
        message(FATAL_ERROR "Failed to download ${url}: ${_message}")
    endif()
endfunction()

# Makes an MSVC import library from the .def next to the DLL, with the DLL's own name in the import descriptors.
function(volengine_msvc_import_library dll out)
    get_filename_component(_dir "${dll}" DIRECTORY)
    get_filename_component(_name "${dll}" NAME)
    if(NOT EXISTS "${_dir}/volengine.def")
        message(FATAL_ERROR "VOLENGINE_NATIVE_LIB=${dll}: volengine.def must be next to the DLL to link with MSVC")
    endif()
    find_program(_lib_exe NAMES lib)
    if(NOT _lib_exe)
        message(FATAL_ERROR "lib.exe not found: run from a Visual Studio developer prompt")
    endif()
    set(_def "${CMAKE_BINARY_DIR}/volengine-native/volengine.generated.def")
    file(READ "${_dir}/volengine.def" _contents)
    file(WRITE "${_def}" "LIBRARY ${_name}\n${_contents}")
    set(_implib "${CMAKE_BINARY_DIR}/volengine-native/volengine_native.lib")
    execute_process(
        COMMAND "${_lib_exe}" "/def:${_def}" "/out:${_implib}" "/machine:x64"
        RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "lib.exe /def failed")
    endif()
    set(${out} "${_implib}" PARENT_SCOPE)
endfunction()

# Sets _lib and _implib (Windows only) in the caller's scope from VOLENGINE_NATIVE_LIB.
function(volengine_local_library lib_out implib_out)
    get_filename_component(_lib "$ENV{VOLENGINE_NATIVE_LIB}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
    if(NOT EXISTS "${_lib}")
        message(FATAL_ERROR "VOLENGINE_NATIVE_LIB=${_lib} does not exist")
    endif()
    set(${lib_out} "${_lib}" PARENT_SCOPE)
    if(NOT WIN32)
        return()
    endif()
    if(MSVC)
        volengine_msvc_import_library("${_lib}" _implib)
    else()
        set(_implib "${_lib}.a")
    endif()
    set(${implib_out} "${_implib}" PARENT_SCOPE)
endfunction()

# Downloads the library of the host platform to a file named as the loader asks for (the SONAME or install_name of the
# build). On Windows that is libvolengine.dll, the name the release .lib (made with /name:libvolengine.dll) and the
# MinGW .dll.a both record.
function(volengine_released_library lib_out implib_out)
    if(NOT VOLENGINE_VERSION)
        message(FATAL_ERROR
            "VOLENGINE_VERSION is empty: this checkout is not on a release tag. Pass -DVOLENGINE_VERSION=v1.0.0 to "
            "download that release, or set the environment variable VOLENGINE_NATIVE_LIB to a local build.")
    endif()
    volengine_host_platform(_os _arch)
    volengine_asset_name("${_os}" "${_arch}" _asset)
    set(_base "https://github.com/GabrielMarquezMatte/VolEngine/releases/download/${VOLENGINE_VERSION}")
    volengine_cache_directory("${CMAKE_BINARY_DIR}" "${VOLENGINE_VERSION}" _cache)
    file(MAKE_DIRECTORY "${_cache}")
    string(REGEX REPLACE "\.[a-z]+$" "" _stem "${_asset}")
    if(WIN32 AND MSVC)
        set(_lib "${_cache}/libvolengine.dll")
        volengine_download("${_base}/${_stem}.lib" "${_cache}/${_stem}.lib")
        set(${implib_out} "${_cache}/${_stem}.lib" PARENT_SCOPE)
    elseif(WIN32)
        set(_lib "${_cache}/libvolengine.dll")
        volengine_download("${_base}/${_stem}.dll.a" "${_cache}/${_stem}.dll.a")
        set(${implib_out} "${_cache}/${_stem}.dll.a" PARENT_SCOPE)
    elseif(APPLE)
        set(_lib "${_cache}/libvolengine.dylib")
    else()
        set(_lib "${_cache}/libvolengine.so")
    endif()
    volengine_download("${_base}/${_asset}" "${_lib}")
    set(${lib_out} "${_lib}" PARENT_SCOPE)
endfunction()

function(volengine_fetch_native_lib)
    set(_implib "")
    if(DEFINED ENV{VOLENGINE_NATIVE_LIB})
        volengine_local_library(_lib _implib)
    else()
        volengine_released_library(_lib _implib)
    endif()

    add_library(volengine_native SHARED IMPORTED GLOBAL)
    set_target_properties(volengine_native PROPERTIES IMPORTED_LOCATION "${_lib}")
    if(WIN32)
        set_target_properties(volengine_native PROPERTIES IMPORTED_IMPLIB "${_implib}")
    elseif(APPLE)
        set_target_properties(volengine_native PROPERTIES IMPORTED_SONAME "@rpath/libvolengine.dylib")
    else()
        set_target_properties(volengine_native PROPERTIES IMPORTED_SONAME "libvolengine.so")
    endif()
    add_library(volengine::native ALIAS volengine_native)
endfunction()
